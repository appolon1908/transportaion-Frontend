{
  "name": "freight-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:production": "vite build --config vite.production.config.ts",
    "typecheck:production": "vue-tsc --noEmit -p tsconfig.portal.json",
    "test": "vitest run",
    "test:portal": "node tests/portal_contract.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.85.5",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  }
}
